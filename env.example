# Copy this file to ".env" and fill in your own values.

# Required: your Google Gemini API key.
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Optional: which Gemini model to use. Defaults to gemini-1.5-flash.
# Other options include gemini-1.5-pro.
GEMINI_MODEL=gemini-1.5-flash

# Optional: comma-separated list of origins allowed to call the API.
# Defaults to the local dev server itself.
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
